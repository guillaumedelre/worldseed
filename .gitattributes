# Worldseed - regles de traitement des fichiers par git
#
# DEUX ROLES DISTINCTS, souvent confondus :
#   1. `text=auto` / `-text` decide de la conversion de fins de ligne.
#      Un .uasset converti en CRLF est un .uasset CORROMPU, silencieusement.
#   2. `filter=lfs` deplace le contenu vers Git LFS et ne laisse qu'un pointeur
#      dans l'historique. Sans cela, chaque version d'un binaire est stockee en
#      entier et le depot enfle sans retour possible.
#
# Tout binaire d'Unreal doit donc porter LES DEUX : `filter=lfs ... -text`.

* text=auto

# ------------------------------------------------------------ binaires Unreal
*.uasset  filter=lfs diff=lfs merge=lfs -text
*.umap    filter=lfs diff=lfs merge=lfs -text
*.ubulk   filter=lfs diff=lfs merge=lfs -text
*.uexp    filter=lfs diff=lfs merge=lfs -text
*.uptnl   filter=lfs diff=lfs merge=lfs -text
*.upk     filter=lfs diff=lfs merge=lfs -text
*.udk     filter=lfs diff=lfs merge=lfs -text

# ------------------------------------------------------------ images et medias
*.png  filter=lfs diff=lfs merge=lfs -text
*.jpg  filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.tga  filter=lfs diff=lfs merge=lfs -text
*.exr  filter=lfs diff=lfs merge=lfs -text
*.psd  filter=lfs diff=lfs merge=lfs -text
*.hdr  filter=lfs diff=lfs merge=lfs -text
*.wav  filter=lfs diff=lfs merge=lfs -text
*.mp3  filter=lfs diff=lfs merge=lfs -text
*.ogg  filter=lfs diff=lfs merge=lfs -text
*.fbx  filter=lfs diff=lfs merge=lfs -text
*.glb  filter=lfs diff=lfs merge=lfs -text
*.gltf filter=lfs diff=lfs merge=lfs -text

# ------------------------------------------------------------------- polices
# Une police est un binaire comme un autre, et celle de nos icones pese 10 Mo :
# sans LFS, chaque version en serait stockee entiere dans l'historique.
# Elle ne passe PAS par un .uasset -- voir Content/Worldseed/Fonts/PROVENANCE.md.
*.ttf  filter=lfs diff=lfs merge=lfs -text
*.otf  filter=lfs diff=lfs merge=lfs -text

# ------------------------------------------------------------ texte, explicite
# Ces fichiers sont lus et edites a la main : on veut des diffs lisibles et des
# fins de ligne stables, quelle que soit la machine.
*.py        text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.ini       text eol=crlf
*.uproject  text eol=lf
*.uplugin   text eol=lf
*.cpp       text
*.h         text
*.cs        text

# Pas de conflit de fusion utile sur ces formats : git ne doit pas essayer.
*.uasset merge=binary
*.umap   merge=binary
